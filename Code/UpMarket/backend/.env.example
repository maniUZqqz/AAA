# ---- Django core ----
DJANGO_SECRET_KEY=change-me-on-the-main-system
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=UTC
LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Limits / security (production: set DJANGO_DEBUG=false + a long random SECRET_KEY) ----
MAX_UPLOAD_MB=10
THROTTLE_ANON=30/minute
THROTTLE_USER=240/minute
# Behind HTTPS also set:
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000

# ---- Database: Django's built-in SQLite (no setup needed) ----
# Optional custom file location:
# SQLITE_PATH=C:\upmarket-data\db.sqlite3

# ---- Celery / Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
# auto (recommended) = look at the machine on startup:
#   Redis reachable  -> real queue, Celery workers, VIDEO GENERATION WORKS
#   Redis missing    -> run AI jobs inside the request (no Redis needed)
# You never have to edit this by hand. Force a mode with true / false.
# No Redis installed? run install-redis.bat once (downloads a portable Redis).
CELERY_TASK_ALWAYS_EAGER=auto

# ---- Ollama (main system: the machine where the models are installed) ----
# 127.0.0.1, not localhost: on Windows `localhost` tries IPv6 first and
# waits ~2s per call before falling back to IPv4 (Ollama binds IPv4 only).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://192.168.10.80:11434

# Preferred model per task. Only models that are ACTUALLY pulled on the
# machine are used: at run time the app reads `ollama list` (GET /api/tags)
# and skips anything that is not installed.
OLLAMA_MODEL_REASONING=qwq:32b
OLLAMA_MODEL_VISION=qwen3-vl:30b
OLLAMA_MODEL_CODER=qwen3-coder:30b

# Tried in order when the preferred model is missing OR fails (out of VRAM,
# timeout, non-JSON). Leave empty to use vision+coder as the fallbacks.
# On a 12 GB card qwq:32b is a dense 18.5 GB model and only ~29/65 layers fit,
# so a run can be very slow: if market analysis is still slow, simply put
# OLLAMA_MODEL_REASONING=qwen3-vl:30b here-> it is a Mixture-of-Experts model
# (3B active) and runs several times faster on the same card.
# OLLAMA_MODEL_FALLBACKS=qwen3-vl:30b,qwen3-coder:30b
OLLAMA_MODEL_FALLBACK=true
# at most this many models per call (2 = one fallback). Keeps the worst
# case at ~2 timeouts instead of walking the whole model list.
OLLAMA_MODEL_MAX_ATTEMPTS=2

# 32B models load from disk first (1-3 min on this hardware) and THEN think.
# A timeout is never retried (that only multiplies the wait) - the next model
# in the fallback list is tried instead.
OLLAMA_TIMEOUT=600
OLLAMA_RETRIES=2
# Auto-allocate GPU layers (Ollama fits as much as possible in 12GB)
OLLAMA_NUM_GPU=-1
# How long a model stays in VRAM after a call. Short, so the next model (or
# ComfyUI) is not starved on a single card.
OLLAMA_KEEP_ALIVE=5m
# Context window per request. Smaller = less KV cache = more room for weights.
OLLAMA_NUM_CTX=8192
# Token budget for JSON answers. Every extra token is CPU seconds when a model
# is only partly offloaded.
OLLAMA_NUM_PREDICT_JSON=4096

# ---- ComfyUI ----
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=900
COMFYUI_POLL_INTERVAL=2.0

# ---- Generation ----
VIDEO_SEGMENT_DURATION=5
GPU_CONCURRENCY_LIMIT=1
# single-GPU coordination: before ComfyUI work the Ollama models are unloaded,
# and before heavy Ollama work ComfyUI VRAM is freed AND every other Ollama
# model is evicted (best-effort, safe)
GPU_AUTO_UNLOAD=true

# ---- Dead-job cleanup ----
# A job whose worker died would otherwise show an endless spinner. These are
# the ages after which a job is declared dead (seconds). Defaults are derived
# from the timeouts above; only set them to override.
# JOB_RUNNING_STALE_SECONDS=2400
# JOB_QUEUED_STALE_SECONDS=300
# JOB_GPU_QUEUED_STALE_SECONDS=2700

# ---- Voice (TTS) ----
# edge = Microsoft neural voices (Persian supported; needs internet)
TTS_PROVIDER=edge
# voice per narration language (chosen in the video studio UI):
TTS_VOICE_FA=fa-IR-FaridNeural
TTS_VOICE_EN=en-US-ChristopherNeural
# gTTS fallback does NOT support Persian:
# TTS_PROVIDER=gtts
# TTS_LANGUAGE=en

# ---- Semantic product search (vector embeddings) ----
# OFF by default - no embedding model is installed yet. To enable on the main
# system:  ollama pull nomic-embed-text   then set:
EMBEDDINGS_ENABLED=false
OLLAMA_MODEL_EMBEDDING=nomic-embed-text

# ---- Web research (competitor sites beyond Digikala/Torob) ----
# searxng = self-hosted metasearch (recommended - your own instance, never blocked)
#   docker run -d -p 8888:8080 searxng/searxng
#   then in its settings.yml under `search:` add `formats: [html, json]`
# brave   = official Brave Search API (free key from brave.com/search/api)
WEB_SEARCH_PROVIDER=none
# SEARXNG_BASE_URL=http://127.0.0.1:8888
# BRAVE_API_KEY=

# ---- Publishing (n8n) ----
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/upmarket-publish
# N8N_WEBHOOK_TOKEN=change-me
PUBLIC_BASE_URL=http://localhost:8000
